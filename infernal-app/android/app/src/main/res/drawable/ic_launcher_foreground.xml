<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      ±1 App Icon — Safe zone: center 66dp circle (coords 21-87)
      Design: smiley face as main element, ±1 as bold graphic overlay
      Colors: white #E7EDF3 (face), green #35D99A (±1 symbol)
      All elements within safe zone, min stroke 3dp, chunky shapes
    -->

    <!-- Oeil gauche — cercle plein, gros et visible -->
    <path
        android:fillColor="#E7EDF3"
        android:pathData="M42,42 m-5,0 a5,5 0 1,1 10,0 a5,5 0 1,1 -10,0" />

    <!-- Oeil droit — cercle plein -->
    <path
        android:fillColor="#E7EDF3"
        android:pathData="M66,42 m-5,0 a5,5 0 1,1 10,0 a5,5 0 1,1 -10,0" />

    <!-- Sourire — arc epais, bien courbe -->
    <path
        android:strokeColor="#E7EDF3"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M37,55 Q54,72 71,55" />

    <!-- ±1 en gros et gras en dessous du sourire -->
    <!-- Barre horizontale du + (haut) -->
    <path
        android:fillColor="#35D99A"
        android:pathData="M34,70 L52,70 L52,74 L34,74 Z" />

    <!-- Barre verticale du + -->
    <path
        android:fillColor="#35D99A"
        android:pathData="M41,63 L45,63 L45,81 L41,81 Z" />

    <!-- Barre du minus (bas, sous le +) -->
    <path
        android:fillColor="#35D99A"
        android:pathData="M34,83 L52,83 L52,87 L34,87 Z" />

    <!-- Le chiffre "1" — gros, gras -->
    <path
        android:fillColor="#E7EDF3"
        android:pathData="M60,63 L67,60 L67,87 L60,87 Z" />
    <!-- Barre de base du 1 -->
    <path
        android:fillColor="#E7EDF3"
        android:pathData="M56,83 L73,83 L73,87 L56,87 Z" />

</vector>
