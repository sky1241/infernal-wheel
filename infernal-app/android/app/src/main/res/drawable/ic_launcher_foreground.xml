    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      ±1 App Icon v4 — Bible-driven redesign
      Safe zone: 66dp circle, coords 21-87, center 54
      Rules applied: A1 (safe zone), B3 (contrast 10:1), C3 (silhouette test),
      C5 (optical centering), C6 (bold typo), D1 (minimalism)
      Green bg + dark fg (#0E1319 on #35D99A = 10:1 contrast)
    -->

    <!-- === ±1 SYMBOL (upper half — "dans la tête") === -->

    <!-- Plus-minus: single bold block approach -->
    <!-- Horizontal bar TOP of ± (the plus crossbar) -->
    <path
        android:fillColor="#0E1319"
        android:pathData="M30,27 L56,27 L56,33 L30,33 Z" />

    <!-- Vertical bar of + -->
    <path
        android:fillColor="#0E1319"
        android:pathData="M39,21 L47,21 L47,39 L39,39 Z" />

    <!-- Horizontal bar BOTTOM of ± (the minus) -->
    <path
        android:fillColor="#0E1319"
        android:pathData="M30,41 L56,41 L56,47 L30,47 Z" />

    <!-- The digit "1" — bold single stroke + base -->
    <path
        android:fillColor="#0E1319"
        android:pathData="M64,21 L72,21 L72,47 L64,47 Z" />
    <!-- Base serif of 1 -->
    <path
        android:fillColor="#0E1319"
        android:pathData="M59,41 L77,41 L77,47 L59,47 Z" />

    <!-- === SMILEY FACE (lower half) === -->

    <!-- Left eye — big bold circle -->
    <path
        android:fillColor="#0E1319"
        android:pathData="M38,60 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0" />

    <!-- Right eye — big bold circle -->
    <path
        android:fillColor="#0E1319"
        android:pathData="M70,60 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0" />

    <!-- Smile — wide, thick, warm arc -->
    <path
        android:strokeColor="#0E1319"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M33,75 Q54,92 75,75" />

